<Window x:Class="TrabajoIGU.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrabajoIGU"
        mc:Ignorable="d"
        Title="Gestión Restaurante" MinHeight="650" MinWidth="900" Height="650" Width="900" WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="LvPlatosMenu_MouseLeftButtonDown">
    <Grid>
        <Grid x:Name="gridRestaurante">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <!-- Sala -->
                <ColumnDefinition Width="1.5*" />
                <!-- Panel lateral -->
            </Grid.ColumnDefinitions>

            <!-- ======== CANVAS DE MESAS ======== -->
            <Grid Grid.Column="0">
                <!-- Imagen de fondo -->
                <Image Source="Imagenes/sueloRestaurante.jpg"
                       Stretch="UniformToFill"
                       Opacity="0.9"
                       Panel.ZIndex="0"/>

                <!-- Canvas encima -->
                <Canvas x:Name="canvasSala"
                        Background="Transparent"
                        MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                        Panel.ZIndex="1"
                        SizeChanged="canvasSala_SizeChanged"/>
            </Grid>

            <!-- ======== PANEL LATERAL ======== -->

            <StackPanel Grid.Column="1" Margin="20" Background="#FFF9F9F9">

                <!-- =============================== -->
                <!--        INFORMACIÓN GENERAL      -->
                <!-- =============================== -->
                <TextBlock Text="Información del Restaurante"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0 0 0 10"/>

                <TextBlock x:Name="txtResumenRestaurante"
                           Text="Mesas activas: 0"
                           Margin="0 0 0 10"/>
                <TextBlock x:Name="txtAforoRestaurante"
                           Text="Aforo: 0/96"
                           Margin="0 0 0 20"/>

                <!-- =============================== -->
                <!--  EST / MENU / VISTA / REINICIO  -->
                <!-- =============================== -->
                <Button x:Name="btnEstadisticasGlobales"
                        Content="Estadísticas globales"
                        Background="#3C7EFF"
                        Foreground="White"
                        Margin="0 0 0 10"
                        Padding="10"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Stretch"
                        Click="BtnEstadisticasGlobales_Click"/>
                
                <Button x:Name="btnGestionMenu"
                        Content="Gestión del Menú"
                        Background="#3C7EFF"
                        Foreground="White"
                        Margin="0 0 0 10"
                        Padding="10"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Stretch"
                        Click="BtnGestionMenu_Click"/>

                <Button x:Name="btnVistaRestaurante"
                        Content="Vista del Restaurante"
                        Background="#3C7EFF"
                        Foreground="White"
                        Margin="0 0 0 10"
                        Padding="10"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Stretch"
                        Click="BtnVistaRestaurante_Click"/>

                <Button Content="Iniciar/Reiniciar Sesión"
                        Click="BtnReiniciar_Click"
                        Background="#3C7EFF"
                        Foreground="White"
                        Padding="10"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Stretch"
                        Margin="0 0 0 20"/>


                <!-- =============================== -->
                <!--      INFORMACIÓN DE LA MESA     -->
                <!-- =============================== -->
                <TextBlock Text="Información de la mesa"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0 0 0 10"/>

                <TextBlock Text="ID Mesa:" FontWeight="Bold"/>
                <TextBlock x:Name="txtIdMesa" Margin="0 0 0 10"/>

                <TextBlock Text="Estado:" FontWeight="Bold"/>
                <TextBlock x:Name="txtEstado" Margin="0 0 0 10"/>

                <TextBlock Text="Capacidad:" FontWeight="Bold"/>
                <TextBlock x:Name="txtCapacidad" Margin="0 0 0 10"/>

                <TextBlock Text="Comensales actuales:" FontWeight="Bold"/>
                <TextBlock x:Name="txtComensales" Margin="0 0 0 10"/>

                <TextBlock Text="Platos en comanda:" FontWeight="Bold"/>
                <TextBlock x:Name="txtPlatos" Margin="0 0 0 10"/>

                <Button x:Name="btnEstadisticasMesa"
                        Content="Estadísticas de la mesa"
                        Background="#3C7EFF"
                        Foreground="White"
                        Margin="10 10 0 0"
                        Padding="10"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"
                        Click="BtnEstadisticasMesa_Click"/>

            </StackPanel>
        </Grid>

        <!-- MENU -->
        <Grid x:Name="gridGestionMenu" Visibility="Collapsed" Margin="15" >

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Título + volver -->
                <RowDefinition Height="Auto"/>
                <!-- Añadir plato -->
                <RowDefinition Height="*"/>
                <!-- Expander + Lista -->
            </Grid.RowDefinitions>

            <!-- ===================================================== -->
            <!--  FILA 0 — TÍTULO + BOTÓN VOLVER                       -->
            <!-- ===================================================== -->
            <TextBlock Text="Gestión del Menú"
                       FontSize="24"
                       FontWeight="Bold" TextAlignment="Center"/>


            <!-- ===================================================== -->
            <!--  FILA 1 — BOTÓN AÑADIR PLATO Y VOLVER                 -->
            <!-- ===================================================== -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 10 0 10" HorizontalAlignment="Center">
                <Button Content="Volver"
                        Grid.Row="1"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Padding="6"
                        Width="150"
                        Margin="0 0 10 0"
                        Click="BtnVolverGestionMenu_Click"/>

                <Button Content="＋ Añadir plato"
                        Grid.Row="1"
                        x:Name="btnAgregarPlatoMenu"
                        Background="#3C7EFF"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Padding="6"
                        Width="150"
                        Click="BtnAgregarPlatoMenu_Click"/>
            </StackPanel>

            <!-- ===================================================== -->
            <!--  FILA 2 — EXPANDER + LISTADO                          -->
            <!-- ===================================================== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Se ajusta según expander -->
                    <ColumnDefinition Width="*"/>
                    <!-- Lista ocupa el resto -->
                </Grid.ColumnDefinitions>

                <!-- FILTROS EN EXPANDER -->
                <Expander Grid.Column="0"
                          Header="🔎"
                          Margin="0 15 25 0"
                          VerticalAlignment="Top"
                          ExpandDirection="Right">  

                    <StackPanel Margin="20 0 0 0" Width="Auto">

                        <TextBlock Text="Buscador por filtros" Margin="0 0 0 10" FontWeight="SemiBold" FontSize="14"/>

                        <TextBlock Text="Texto:" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtBuscarMenu"
                                 Margin="0 3 0 10"
                                 TextChanged="FiltroMenu_Changed"/>

                        <TextBlock Text="Categoría:" FontWeight="SemiBold"/>
                        <ComboBox x:Name="cbCategoriaMenu"
                                  SelectedIndex="0"
                                  Margin="0 3 0 10"
                                  SelectionChanged="FiltroMenu_Changed">
                            <ComboBoxItem Content="Todas"/>
                            <ComboBoxItem Content="Primero"/>
                            <ComboBoxItem Content="Segundo"/>
                            <ComboBoxItem Content="Postre"/>
                        </ComboBox>

                        <Button Content="Limpiar filtros"
                                Width="120"
                                Padding="5"
                                Margin="10"
                                Background="#DDDDDD"
                                BorderThickness="0"
                                Click="BtnLimpiarFiltrosMenu_Click"/>   
                    </StackPanel>
                </Expander>


                <!-- LISTADO DE PLATOS A LA DERECHA -->
                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto">

                    <ListBox x:Name="lvPlatosMenu"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalAlignment="Center"
                             SelectionMode="Single"
                             MouseDoubleClick="LvPlatosMenu_MouseDoubleClick"
                             MouseLeftButtonDown="LvPlatosMenu_MouseLeftButtonDown">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <!-- quitamos padding y fondo por defecto -->
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="10"/>
                                <Setter Property="Background" Value="Transparent"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <!-- Marco exterior redondeado que se colorea al seleccionar -->
                                            <Border x:Name="outerBorder"
                                                    CornerRadius="12"
                                                    BorderThickness="2"
                                                    BorderBrush="Transparent"
                                                    Background="Transparent">
                                                <ContentPresenter />
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <!-- SELECCIONADO -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="outerBorder" Property="BorderBrush" Value="#3C7EFF"/>
                                                    <Setter TargetName="outerBorder" Property="Background" Value="#E7F0FF"/>
                                                </Trigger>

                                                <!-- HOVER (ratón encima) -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="outerBorder" Property="BorderBrush" Value="#8AAEFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border BorderThickness="1"
                                        BorderBrush="#C9C9C9"
                                        CornerRadius="10"
                                        Padding="10"
                                        Background="White"
                                        Width="180">

                                    <Border.Effect>
                                        <DropShadowEffect Color="Black"
                                                          BlurRadius="8"
                                                          Opacity="0.15"/>
                                    </Border.Effect>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Nombre}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding Categoria}"
                                                   Margin="0 4 0 0"
                                                   Foreground="#3C7EFF"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="{Binding Descripcion}"
                                                   Margin="0 6 0 0"
                                                   TextWrapping="Wrap"
                                                   Foreground="Gray"/>
                                    </StackPanel>

                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>
                </ScrollViewer>

            </Grid>

        </Grid>

        <!-- =================================================== -->
        <!--   ESTADÍSTICAS GLOBALES (OCULTO INICIALMENTE)      -->
        <!-- =================================================== -->
        <Grid x:Name="gridEstadisticasGlobales" Visibility="Collapsed" Margin="15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TÍTULO -->
            <TextBlock Text="Estadísticas globales"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Grid.Row="0"/>

            <!-- BOTÓN VOLVER -->
            <StackPanel Grid.Row="1"
                        Margin="0 10 0 20"
                        HorizontalAlignment="Center">
                <Button Content="Volver"
                        Padding="8"
                        Width="150"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Background="#3C7EFF"
                        Foreground="White"
                        Click="BtnVolverEstadisticasGlobales_Click"/>
            </StackPanel>

            <!-- CANVAS DEL GRÁFICO -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="canvasEstadisticasGlobales"
                        Background="White"
                        Height="500"/>
            </ScrollViewer>

        </Grid>

        <!-- =================================================== -->
        <!--   ESTADÍSTICAS DE LA MESA (OCULTO INICIALMENTE)    -->
        <!-- =================================================== -->
        <Grid x:Name="gridEstadisticasMesa" Visibility="Collapsed" Margin="15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TÍTULO (AUTOMÁTICO SEGÚN LA MESA SELECCIONADA) -->
            <TextBlock x:Name="txtTituloEstadisticaMesa"
                       Text="Estadísticas de la mesa"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Grid.Row="0"/>

            <!-- BOTÓN VOLVER -->
            <StackPanel Grid.Row="1"
                        Margin="0 10 0 20"
                        HorizontalAlignment="Center">
                <Button Content="Volver"
                        Padding="8"
                        Width="150"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Background="#3C7EFF"
                        Foreground="White"
                        Click="BtnVolverEstadisticasMesa_Click"/>
            </StackPanel>

            <!-- CANVAS DEL GRÁFICO -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="canvasEstadisticasMesa"
                        Background="White"
                        Height="500"/>
            </ScrollViewer>

        </Grid>


    </Grid>
    
</Window>
