<Window x:Class="TrabajoIGU.InputMesaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrabajoIGU"
        mc:Ignorable="d"
        Title="Nueva Mesa" Height="180" Width="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Capacidad máxima (mínimo 2):" Margin="0 0 0 5"/>
            <TextBox x:Name="txtCapacidad" Margin="0 0 0 10" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Aceptar" Width="80" Margin="0 0 5 0" Click="Aceptar_Click"/>
                <Button Content="Cancelar" Width="80" Click="Cancelar_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
