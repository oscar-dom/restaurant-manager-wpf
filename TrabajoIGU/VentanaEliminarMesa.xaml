<Window x:Class="TrabajoIGU.VentanaEliminarMesa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrabajoIGU"
        mc:Ignorable="d"
        Title="Eliminar Mesa" Height="220" Width="380"
        WindowStartupLocation="CenterOwner">    
    
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Eliminar mesa" FontSize="20" FontWeight="Bold"/>

            <TextBlock Text="ID de la mesa a eliminar:"/>
            <TextBox x:Name="txtId" Width="100"/>

            <Button Content="Eliminar"
                    Click="BtnEliminar_Click"
                    Background="#FFD9534F"
                    Foreground="White"
                    Padding="8"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Width="120"
                    Cursor="Hand"
                    Margin="0 10 0 0"/>

            <TextBlock x:Name="txtResultado" FontStyle="Italic" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Window>
