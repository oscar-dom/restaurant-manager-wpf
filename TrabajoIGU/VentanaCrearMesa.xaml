<Window x:Class="TrabajoIGU.VentanaCrearMesa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrabajoIGU"
        mc:Ignorable="d"
        Title="Añadir Mesa" Height="250" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Añadir nueva mesa" FontSize="20" FontWeight="Bold"/>

            <TextBlock Text="Capacidad máxima:"/>
            <TextBox x:Name="txtCapacidad" Width="100"/>

            <TextBlock Text="Posición (1–12):"/>
            <TextBox x:Name="txtPosicion" Width="100"/>

            <Button Content="Crear mesa"
                Click="BtnCrear_Click"
                Background="#FF3C7EFF"
                Foreground="White"
                Padding="8"
                FontWeight="Bold"
                BorderThickness="0"
                Width="120"
                Cursor="Hand"
                Margin="0 10 0 0"/>

            <TextBlock x:Name="txtResultado" FontStyle="Italic" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Window>
