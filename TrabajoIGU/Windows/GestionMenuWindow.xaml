<Window x:Class="TrabajoIGU.Windows.GestionMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrabajoIGU.Windows"
        mc:Ignorable="d"
        Title="Gestión del Menú"
        Width="450" Height="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título + Botón Añadir -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Gestión del Menú"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0 0 0 10"/>

            <Button Content="Añadir Plato"
                    x:Name="btnAgregarPlato"
                    Width="150"
                    Height="32"
                    HorizontalAlignment="Left"
                    Click="BtnAgregarPlato_Click"/>
        </StackPanel>

        <!-- Filtros -->
        <Expander Grid.Row="1"
                  Header="Filtros de búsqueda"
                  Margin="0 15 0 10">

            <StackPanel Margin="10">

                <TextBlock Text="Nombre:"/>
                <TextBox x:Name="txtBuscar"
                         Margin="0 3 0 10"
                         TextChanged="Filtro_Changed"/>

                <TextBlock Text="Categoría:"/>
                <ComboBox x:Name="cbCategoria"
                          SelectedIndex="0"
                          Margin="0 3 0 10"
                          SelectionChanged="Filtro_Changed">
                    <ComboBoxItem Content="Todas"/>
                    <ComboBoxItem Content="Primero"/>
                    <ComboBoxItem Content="Segundo"/>
                    <ComboBoxItem Content="Postre"/>
                </ComboBox>

                <Button Content="Limpiar filtros"
                        Margin="0 10 0 10"
                        Width="120"
                        HorizontalAlignment="Center"
                        Click="BtnLimpiarFiltros_Click"/>

            </StackPanel>
        </Expander>

        <!-- Lista de Platos -->
        <ScrollViewer Grid.Row="2" Cursor="">
            <ListView x:Name="lvPlatos"
                      SelectionMode="Single">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0 0 0 10">

                            <StackPanel>
                                <TextBlock Text="{Binding Nombre}"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <TextBlock Text="{Binding Categoria}"
                                           Foreground="DarkSlateBlue"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="{Binding Descripcion}"
                                           Foreground="DimGray"
                                           Margin="0 5 0 0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>
        </ScrollViewer>

    </Grid>
</Window>