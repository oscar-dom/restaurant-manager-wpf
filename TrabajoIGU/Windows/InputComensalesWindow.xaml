<Window x:Class="TrabajoIGU.Windows.InputComensalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrabajoIGU"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Icon="/Imagenes/IconoRestaurante.ico"
        Height="180" Width="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Número de comensales actuales:" Margin="0 0 0 20"/>
            <xctk:IntegerUpDown x:Name="numComensales"
                                Minimum="0"
                                Maximum="10"
                                Width="80"
                                HorizontalAlignment="Center"
                                Value="0"/> 

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20 0 0">
                <Button Content="Aceptar" Width="80" Margin="0 0 10 0" Click="Aceptar_Click"/>
                <Button Content="Cancelar" Width="80" Click="Cancelar_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
